<Controls:MetroWindow x:Class="livelywpf.Voice.BarqVoicePanel"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:Controls="clr-namespace:MahApps.Metro.Controls;assembly=MahApps.Metro"
    Title="BARQ Voice Control"
    Width="870" Height="670" MinWidth="680" MinHeight="540"
    WindowStartupLocation="CenterScreen"
    ResizeMode="CanResizeWithGrip"
    ShowTitleBar="True" ShowIconOnTitleBar="False"
    WindowTransitionsEnabled="False"
    Background="{DynamicResource AMBackground}"
    Foreground="{DynamicResource AMText}"
    FontFamily="Segoe UI, Tahoma" FontSize="13"
    TextOptions.TextFormattingMode="Display"
    TextOptions.TextRenderingMode="ClearType"
    UseLayoutRounding="True" SnapsToDevicePixels="True">
    <Grid Margin="22,18,22,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Margin="0,0,0,18">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Border Width="54" Height="54" CornerRadius="13" Padding="8"
                    Background="{DynamicResource AMSurface}"
                    BorderBrush="{DynamicResource AMBorder}" BorderThickness="1">
                <Image Source="{StaticResource AMBrandMark}" Stretch="Uniform"/>
            </Border>
            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="15,0,0,0">
                <TextBlock Text="BARQ Voice" FontSize="23" FontWeight="SemiBold"
                           Foreground="{DynamicResource AMText}"/>
                <TextBlock Text="Voice control, Gemini conversations and wallpaper commands"
                           Foreground="{DynamicResource AMMuted}" TextWrapping="Wrap"
                           Margin="0,4,0,0"/>
            </StackPanel>
            <Border Grid.Column="2" Background="{DynamicResource AMSurface}"
                    BorderBrush="{DynamicResource AMBorder}" BorderThickness="1"
                    CornerRadius="9" Padding="11,8" VerticalAlignment="Center">
                <TextBlock x:Name="StatusBadge" Text="MIC OFF"
                           Foreground="{DynamicResource AMAccent}" FontWeight="SemiBold"/>
            </Border>
        </Grid>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="0.92*"/>
                <ColumnDefinition Width="1.12*"/>
            </Grid.ColumnDefinitions>
            <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled" Margin="0,0,16,0">
                <StackPanel>
                    <Border Background="{DynamicResource AMSidebar}"
                            BorderBrush="{DynamicResource AMBorder}" BorderThickness="1"
                            CornerRadius="12" Padding="16" Margin="0,0,0,13">
                        <StackPanel>
                            <TextBlock Text="Listening status" FontSize="16" FontWeight="SemiBold"
                                       Foreground="{DynamicResource AMText}" Margin="0,0,0,14"/>
                            <TextBlock Text="MICROPHONE" Foreground="{DynamicResource AMMuted}"
                                       FontWeight="SemiBold" FontSize="10"/>
                            <TextBlock x:Name="MicrophoneState" Text="Off"
                                       Foreground="{DynamicResource AMText}" FontSize="14"
                                       Margin="0,4,0,12"/>
                            <TextBlock Text="RECOGNITION LANGUAGE" Foreground="{DynamicResource AMMuted}"
                                       FontWeight="SemiBold" FontSize="10"/>
                            <TextBlock x:Name="EngineState" Text="Not started"
                                       Foreground="{DynamicResource AMText}" TextWrapping="Wrap"
                                       Margin="0,4,0,12"/>
                            <TextBlock Text="NATURAL QUESTIONS" Foreground="{DynamicResource AMMuted}"
                                       FontWeight="SemiBold" FontSize="10"/>
                            <TextBlock x:Name="DictationState" Text="Not checked"
                                       Foreground="{DynamicResource AMText}" TextWrapping="Wrap"
                                       Margin="0,4,0,12"/>
                            <TextBlock Text="GEMINI API" Foreground="{DynamicResource AMMuted}"
                                       FontWeight="SemiBold" FontSize="10"/>
                            <TextBlock x:Name="GeminiState" Text="Not configured"
                                       Foreground="{DynamicResource AMText}" Margin="0,4,0,2"/>
                        </StackPanel>
                    </Border>

                    <Border Background="{DynamicResource AMSidebar}"
                            BorderBrush="{DynamicResource AMBorder}" BorderThickness="1"
                            CornerRadius="12" Padding="16" Margin="0,0,0,13">
                        <StackPanel>
                            <TextBlock Text="Voice controls" FontSize="16" FontWeight="SemiBold"
                                       Foreground="{DynamicResource AMText}" Margin="0,0,0,12"/>
                            <Button x:Name="StartStopButton" Content="Start listening"
                                    Style="{StaticResource AMPrimaryButton}"
                                    Click="StartStopClick" Margin="0,0,0,9"/>
                            <Button Content="Configure Gemini key"
                                    Style="{StaticResource AMNavButton}"
                                    Click="ConfigureKeyClick" Margin="0,0,0,9"/>
                            <Button Content="Test speaker"
                                    Style="{StaticResource AMNavButton}"
                                    Click="TestSpeakerClick"/>
                            <TextBlock Text="The microphone stays OFF until you activate it."
                                       Foreground="{DynamicResource AMMuted}" TextWrapping="Wrap"
                                       FontSize="11" Margin="0,12,0,0"/>
                        </StackPanel>
                    </Border>
                    <Border Background="{DynamicResource AMSidebar}"
                            BorderBrush="{DynamicResource AMBorder}" BorderThickness="1"
                            CornerRadius="12" Padding="16">
                        <StackPanel>
                            <TextBlock Text="Wallpaper quick actions" FontSize="16"
                                       FontWeight="SemiBold" Foreground="{DynamicResource AMText}"
                                       Margin="0,0,0,12"/>
                            <Button Content="Open library" Click="OpenLibraryClick"
                                    Style="{StaticResource AMNavButton}" Margin="0,0,0,8"/>
                            <Button Content="Pause wallpapers" Click="PauseWallpaperClick"
                                    Style="{StaticResource AMNavButton}" Margin="0,0,0,8"/>
                            <Button Content="Resume wallpapers" Click="ResumeWallpaperClick"
                                    Style="{StaticResource AMNavButton}"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <Border Grid.Column="1" Background="{DynamicResource AMSidebar}"
                    BorderBrush="{DynamicResource AMBorder}" BorderThickness="1"
                    CornerRadius="12" Padding="16">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <TextBlock Text="Conversation &amp; diagnostics"
                               Foreground="{DynamicResource AMText}"
                               FontSize="16" FontWeight="SemiBold"/>
                    <TextBlock Grid.Row="1" TextWrapping="Wrap" Margin="0,8,0,12"
                               Foreground="{DynamicResource AMMuted}" FontSize="12"
                               Text="Say 'Barq' / 'برق', then speak. Follow-up attention lasts about 16 seconds after the reply."/>
                    <TextBox x:Name="ConversationLog" Grid.Row="2" IsReadOnly="True"
                             TextWrapping="Wrap" AcceptsReturn="True"
                             VerticalScrollBarVisibility="Auto"
                             Background="{DynamicResource AMBackground}"
                             Foreground="{DynamicResource AMText}"
                             BorderBrush="{DynamicResource AMBorder}"
                             BorderThickness="1" Padding="12"
                             Text="BARQ Voice panel ready.&#10;Turn listening on to use the microphone, or enter a question below to test Gemini without speech recognition."/>
                    <Grid Grid.Row="3" Margin="0,12,0,9">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="QuestionInput"
                                 Style="{StaticResource AMInput}"
                                 ToolTip="Ask Gemini using text; no microphone needed."
                                 KeyDown="QuestionInputKeyDown"
                                 VerticalContentAlignment="Center"
                                 Margin="0,0,8,0"/>
                        <Button x:Name="AskButton" Grid.Column="1"
                                Content="Ask Gemini" Click="AskClick"
                                Style="{StaticResource AMPrimaryButton}"/>
                    </Grid>
                    <ProgressBar x:Name="BusyIndicator" Grid.Row="4" Height="4"
                                 IsIndeterminate="True" Visibility="Collapsed"/>
                </Grid>
            </Border>
        </Grid>

        <TextBlock Grid.Row="2" Margin="0,14,0,0"
                   Foreground="{DynamicResource AMMuted}" TextWrapping="Wrap"
                   FontSize="11"
                   Text="Windows 8.1 compatibility: speech uses installed Windows recognizers and voices. Arabic recognition and spoken Arabic require the corresponding language engines. Gemini requires an API key and internet."/>
    </Grid>
</Controls:MetroWindow>