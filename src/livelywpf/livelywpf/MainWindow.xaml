<Controls:MetroWindow x:Class="livelywpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:Controls="clr-namespace:MahApps.Metro.Controls;assembly=MahApps.Metro"
        xmlns:i="http://schemas.microsoft.com/expression/2010/interactivity"
	    xmlns:Behaviours="clr-namespace:MahApps.Metro.Behaviours;assembly=MahApps.Metro"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:livelywpf"
        xmlns:pm="clr-namespace:livelywpf.ProcessManager"
        xmlns:p = "clr-namespace:livelywpf.Properties"                
        xmlns:gif="https://github.com/XamlAnimatedGif/XamlAnimatedGif"
        xmlns:notification="clr-namespace:Enterwell.Clients.Wpf.Notifications.Controls;assembly=Enterwell.Clients.Wpf.Notifications"
                      
        mc:Ignorable="d"
        ResizeMode="CanResize"
        MinWidth="980" MinHeight="630"
        Width="1080"    Height="720"
        ShowTitleBar ="False"
        ShowIconOnTitleBar="False"
        ShowMaxRestoreButton="False"
        Title="AM Lively Wallpaper"
        WindowStartupLocation="CenterScreen"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display" TextOptions.TextRenderingMode="ClearType"
        WindowTransitionsEnabled="False" 
        GlowBrush="{DynamicResource AMAccent}"
        Background="{DynamicResource AMBackground}" Foreground="{DynamicResource AMText}" FontFamily="Segoe UI" FontSize="13"
        AllowsTransparency="True" WindowStyle="None" Drop="MetroWindow_Drop"
        AllowDrop="true">

    <Controls:MetroWindow.Resources>
        <Style TargetType="Label" x:Key="labelGreenH1">
            <Setter Property="Foreground" Value="{DynamicResource AccentColorBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource AccentColorBrush}" />
            <Setter Property="BorderThickness" Value="0,0,0,1" />
            <Setter Property="Margin" Value="0,0,0,5" />
            <Setter Property="FontSize" Value="16" />
        </Style>

        <Storyboard  x:Key="fidgetSpinner">
            <DoubleAnimation
                    Storyboard.TargetProperty="RenderTransform.Angle"
                    From="0"
                    To="360"
                    Duration="0:0:10"
                    RepeatBehavior="Forever" />
        </Storyboard>

        <Storyboard  x:Key="langTextAnim">
            <StringAnimationUsingKeyFrames Storyboard.TargetProperty="(TextBlock.Text)"  RepeatBehavior="Forever" >
                <DiscreteStringKeyFrame KeyTime="0:0:0" Value="Language:"/>
                <DiscreteStringKeyFrame KeyTime="0:0:2" Value="语言:"/>
                <DiscreteStringKeyFrame KeyTime="0:0:4" Value="日本人:"/>
                <DiscreteStringKeyFrame KeyTime="0:0:6" Value="язык:"/>
                <DiscreteStringKeyFrame KeyTime="0:0:8" Value="भाषा:"/>
                <DiscreteStringKeyFrame KeyTime="0:0:10" Value="la langue:"	/>
                <DiscreteStringKeyFrame KeyTime="0:0:12" Value="español:"	/>
            </StringAnimationUsingKeyFrames>
        </Storyboard>

        <Storyboard x:Key="OverlayFastSemiFadeIn" 
             AccelerationRatio=".97" 
             BeginTime="0:0:0" 
             SpeedRatio="2.7" 
             Storyboard.TargetProperty="Opacity">
            <DoubleAnimation To=".7" />
        </Storyboard>
        <Storyboard x:Key="OverlayFastSemiFadeOut" 
             AccelerationRatio=".97" 
             BeginTime="0:0:0" 
             SpeedRatio="2.7" 
             Storyboard.TargetProperty="Opacity">
            <DoubleAnimation To="0.0" />
        </Storyboard>
    </Controls:MetroWindow.Resources>

    <Grid Margin="18,18,18,14" UseLayoutRounding="True" SnapsToDevicePixels="True">
        <Grid.RowDefinitions><RowDefinition Height="78"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="544*"/>
            <ColumnDefinition Width="279*"/>
            <ColumnDefinition Width="63*"/>
            <ColumnDefinition Width="34*"/>
        </Grid.ColumnDefinitions>
        <Controls:MetroTabControl Name="tabControl1" Grid.Row="1" Grid.ColumnSpan="4" Margin="0,5,0,0" Background="{DynamicResource AMBackground}" Foreground="{DynamicResource AMText}">
            <Controls:MetroTabControl.Resources>
                <!-- Private header template: wallpaper controls and page content are untouched. -->
                <Style TargetType="{x:Type TabItem}">
                    <Setter Property="FontFamily" Value="Segoe UI, Tahoma"/>
                    <Setter Property="FontSize" Value="13"/>
                    <Setter Property="FontWeight" Value="SemiBold"/>
                    <Setter Property="Foreground" Value="{DynamicResource AMMuted}"/>
                    <Setter Property="Padding" Value="17,10"/>
                    <Setter Property="Margin" Value="0,0,6,0"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="{x:Type TabItem}">
                                <Border x:Name="NavSurface" Margin="{TemplateBinding Margin}" Padding="{TemplateBinding Padding}"
                                        Background="{DynamicResource AMSidebar}" BorderBrush="{DynamicResource AMBorder}"
                                        BorderThickness="1" CornerRadius="9">
                                    <ContentPresenter ContentSource="Header" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="NavSurface" Property="Background" Value="{DynamicResource AMHover}"/>
                                        <Setter Property="Foreground" Value="{DynamicResource AMText}"/>
                                    </Trigger>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter TargetName="NavSurface" Property="Background" Value="{DynamicResource AMSelection}"/>
                                        <Setter TargetName="NavSurface" Property="BorderBrush" Value="{DynamicResource AMAccent}"/>
                                        <Setter Property="Foreground" Value="{DynamicResource AMText}"/>
                                    </Trigger>
                                    <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                        <Setter TargetName="NavSurface" Property="BorderBrush" Value="{DynamicResource AMAccent}"/>
                                    </Trigger>
                                    <Trigger Property="IsEnabled" Value="False">
                                        <Setter TargetName="NavSurface" Property="Opacity" Value="0.45"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </Controls:MetroTabControl.Resources>
            <TabItem Name="libTab" Header="Library">
                <Grid Background="{DynamicResource AMBackground}" Margin="4,10,4,4">
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="2.2*"/><ColumnDefinition Width="1*"/></Grid.ColumnDefinitions>
                    <Grid Grid.Row="0" Grid.ColumnSpan="2" Margin="0,0,0,16">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="Your wallpaper collection" Foreground="{DynamicResource AMText}" FontSize="22" FontWeight="SemiBold"/>
                            <TextBlock Text="Browse, preview and apply live backgrounds" Foreground="{DynamicResource AMMuted}" FontSize="12" Margin="0,5,0,0"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button Content="+ Import" Click="Button_Click_InstallWallpaper" Style="{StaticResource AMNavButton}" Margin="0,0,8,0"/>
                            <Button Content="+ Create wallpaper" Click="Button_Click_CreateWallpaper" Style="{StaticResource AMPrimaryButton}"/>
                        </StackPanel>
                    </Grid>
                    <Border Grid.Row="1" Grid.Column="0" Margin="0,0,14,0" Background="{DynamicResource AMSidebar}" BorderBrush="{DynamicResource AMBorder}" BorderThickness="1" CornerRadius="14" Padding="10">
                        <DockPanel LastChildFill="True">
                            <Grid DockPanel.Dock="Top" Margin="4,4,4,12">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <Grid>
                                    <TextBox x:Name="textBoxLibrarySearch" Height="34" Padding="10,6" Background="{DynamicResource AMSurface}" Foreground="{DynamicResource AMText}" BorderBrush="{DynamicResource AMBorder}" BorderThickness="1" TextChanged="TextBoxLibrarySearch_TextChanged"/>
                                    <TextBlock IsHitTestVisible="False" Text="Search wallpapers..." Foreground="{DynamicResource AMMuted}" Margin="12,0,0,0" VerticalAlignment="Center">
                                        <TextBlock.Style>
                                            <Style TargetType="{x:Type TextBlock}">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                <Style.Triggers><DataTrigger Binding="{Binding Text, ElementName=textBoxLibrarySearch}" Value=""><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Grid>
                                <Button Grid.Column="1" Content="?" ToolTip="Wallpaper help" Click="Button_Click_HowTo" Style="{StaticResource AMNavButton}" Margin="8,0,0,0"/>
                            </Grid>
                            <ListBox x:Name="wallpapersLV" Background="{DynamicResource AMSidebar}" Foreground="{DynamicResource AMText}" BorderThickness="0" SelectionChanged="WallpapersLV_SelectionChanged" ItemContainerStyle="{StaticResource AMLibraryItem}"
                                     ScrollViewer.VerticalScrollBarVisibility="Auto" ScrollViewer.ScrollChanged="WallpapersLV_ScrollChanged">
                                
                        <!--  ScrollViewer.IsDeferredScrollingEnabled="True"-->

                        <ListBox.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="{x:Static p:Resources.txtContextMenuShowOnDisk}" Click="MenuItem_ShowOnDisk_Click" ></MenuItem>
                                <MenuItem Header="{x:Static p:Resources.txtSetWallpaper}" Click="MenuItem_SetWallpaper_Click" ></MenuItem>
                                <MenuItem Header="{x:Static p:Resources.txtContextMenuExport}" Click="MenuItem_CreateZip_Click" ></MenuItem>
                                <MenuItem Header="{x:Static p:Resources.txtContextMenuDeleteWallpaper}" Click="MenuItem_DeleteWallpaper_Click" ></MenuItem>
                            </ContextMenu>
                        </ListBox.ContextMenu>
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel Name="libraryPanel" HorizontalAlignment="Left" Orientation="Horizontal"   />
                                <!--  <UniformGrid Columns="5" HorizontalAlignment="Stretch"/>  Margin="5,10,0,0"-->
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ListBox.Resources>
                            <Style TargetType="{x:Type ScrollViewer}">
                                <Setter Property="CanContentScroll" Value="True"/>
                            </Style>
                        </ListBox.Resources>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Vertical" Width="136" Height="152" Margin="0,4,8,8" >
                                    <Border BorderBrush="{DynamicResource AccentColorBrush}" BorderThickness="1" CornerRadius="10" Height="112" Width="132" ClipToBounds="True" >
                                        <Grid>
                                            <Image gif:AnimationBehavior.SourceUri="{Binding TilePreview, Converter={StaticResource nullConverter}}" 
                                               Source="{Binding Img, Converter={StaticResource nullConverter}}"  Stretch="UniformToFill" RenderOptions.BitmapScalingMode="HighQuality" />
                                            <Image Source="{Binding WatermarkImg1, Converter={StaticResource nullConverter}}" VerticalAlignment="Top" HorizontalAlignment="Right" Width="15" Height="15" />
                                        </Grid>
                                    </Border >
                                    <TextBlock TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" FontSize="12" Margin="4,8,4,0" Foreground="{DynamicResource AMText}" Text="{Binding LivelyInfo.Title}"  />
                                    <!-- Foreground="#FFF3F3F3"-->
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    
                            </ListBox>
                        </DockPanel>
                    </Border>
                    <Border Grid.Row="1" Grid.Column="1" Background="{DynamicResource AMSurface}" BorderBrush="{DynamicResource AMBorder}" BorderThickness="1" CornerRadius="14" Padding="15">
                        <DockPanel LastChildFill="True">
                            <StackPanel DockPanel.Dock="Top" Margin="0,0,0,12">
                                <TextBlock Text="LIVE PREVIEW" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource AMAccent}"/>
                                <TextBlock Text="Wallpaper details" FontSize="17" FontWeight="SemiBold" Foreground="{DynamicResource AMText}" Margin="0,5,0,0"/>
                            </StackPanel>
                            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                <ItemsControl x:Name="tileInfo">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate >
                                    <StackPanel Orientation="Vertical"  Width="244" Canvas.Left="670" Canvas.Top="169">
                                        <Border BorderBrush="{DynamicResource AccentColorBrush}" BorderThickness="2" Height="126" Width="238" Margin="-5,0,4,0" >
                                            <Image gif:AnimationBehavior.SourceUri="{Binding LivelyInfo.Preview, Converter={StaticResource nullConverter}}"
                                                   gif:AnimationBehavior.RepeatBehavior="Forever" Stretch="UniformToFill" />
                                        </Border>

                                        <Button x:Name="SetWallpaperBtn" Visibility="{Binding SetWpBtnVisibility}" Margin="0,5,10,0" ClickMode="Release" Click="SetWallpaperBtn_Click" 
                                                Background="{DynamicResource AccentColorBrush}"  Foreground="White" Height="29" Canvas.Left="672" Canvas.Top="135" Width="210" >
                                            <WrapPanel HorizontalAlignment="Left">
                                                <Image Source="/images/icons8-wallpaper-24.png" />
                                                <TextBlock Text="{x:Static p:Resources.txtSetWallpaper}"  />
                                            </WrapPanel>
                                        </Button>

                                        <Button x:Name="CustomiseWallpaperBtn" Visibility="{Binding CustomiseWpBtnVisibility}" Margin="0,5,10,0" ClickMode="Release" Click="MenuItem_CustomiseWallpaper_Click" 
                                                Background="{DynamicResource AccentColorBrush3}"  Foreground="White" Height="29" Canvas.Left="672" Canvas.Top="135" Width="210" >
                                            <WrapPanel HorizontalAlignment="Left">
                                                <Image Source="/images/icons8-gear-32.png" />
                                                <TextBlock Text="Customise Wallpaper"  />
                                            </WrapPanel>
                                        </Button>
                                        <!--
                                        <StackPanel>
                                            <TextBox IsReadOnly="True" TextWrapping="Wrap" BorderThickness="0" Text="Speed"/>
                                            <Slider Minimum="0" Maximum="200" />
                                        </StackPanel>
                                        -->
                                        <!--  Foreground="#FFAAA8A8"-->
                                        <TextBox x:Name="LibraryTitle" Background="{DynamicResource AMSurface}" IsReadOnly="True" FontSize="15" TextWrapping="Wrap"  BorderThickness="0,0,0,1" Text="{Binding LivelyInfo.Title}" 
                                                 Foreground="{DynamicResource AccentColorBrush}" Margin="0,0,0,1"/>
                                        <TextBox x:Name="LibraryDesc" Background="{DynamicResource AMSurface}" IsReadOnly="True" TextWrapping="Wrap" BorderThickness="0" Text="{Binding LivelyInfo.Desc}"/>
                                        <TextBox IsReadOnly="True" Background="{DynamicResource AMSurface}" TextWrapping="WrapWithOverflow"  Text="{x:Static p:Resources.txtLabel12}"  BorderThickness="0,0,0,1" 
                                                 Foreground="{DynamicResource AccentColorBrush2}"/>
                                        <TextBox x:Name="LibraryType" Background="{DynamicResource AMSurface}" IsReadOnly="True" TextWrapping="Wrap" BorderThickness="0" Text="{Binding Type}"/>
                                        <TextBox IsReadOnly="True" Background="{DynamicResource AMSurface}" TextWrapping="WrapWithOverflow"  Text="{x:Static p:Resources.txtLabel13}"  BorderThickness="0,0,0,1" 
                                                 Foreground="{DynamicResource AccentColorBrush2}"/>
                                        <TextBox x:Name="LibraryAuthor" Background="{DynamicResource AMSurface}" IsReadOnly="True" TextWrapping="Wrap" BorderThickness="0" Text="{Binding LivelyInfo.Author}"/>
                                        <TextBox  IsReadOnly="True" Background="{DynamicResource AMSurface}" TextWrapping="WrapWithOverflow" Text="{x:Static p:Resources.txtLabel14}"  BorderThickness="0,0,0,1" 
                                                 Foreground="{DynamicResource AccentColorBrush2}"/>

                                        <TextBlock TextWrapping="WrapWithOverflow" Background="{DynamicResource AMSurface}" Canvas.Left="241" Canvas.Top="98">
                                            <Hyperlink x:Name="LibraryContact"  RequestNavigate="Hyperlink_RequestNavigate_Warning" NavigateUri="{Binding UriContact, Converter={StaticResource nullConverter}}" 
                                                       Foreground="{DynamicResource AccentColorBrush}"  ><Run Text="{Binding LivelyInfo.Contact}"/></Hyperlink>
                                        </TextBlock>
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                            </ScrollViewer>
                        </DockPanel>
                    </Border>
                    <TextBlock Grid.Row="2" Grid.ColumnSpan="2" Margin="4,11,0,0" Foreground="{DynamicResource AMMuted}" FontSize="12" Text="Tip: drag a video, GIF or wallpaper file into this window to import it."/>
                </Grid>
            </TabItem>
            <TabItem Header="Add wallpaper">
              <Grid Background="{DynamicResource AMBackground}" Margin="4,12,4,0">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                  <StackPanel Margin="8,4,14,20">
                    <TextBlock Text="Add a new wallpaper" FontSize="24" FontWeight="SemiBold" Foreground="{DynamicResource AMText}" />
                    <TextBlock Text="Choose a format to import or configure. All existing playback options remain available."
                               FontSize="13" TextWrapping="Wrap" Foreground="{DynamicResource AMMuted}" Margin="0,7,0,23"/>
                    <Border Background="{DynamicResource AMSidebar}" BorderBrush="{DynamicResource AMBorder}"
                BorderThickness="1" CornerRadius="12" Padding="20" Margin="0,0,0,16">
                  <StackPanel>
                    <TextBlock Text="Media" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource AMText}"/>
                    <TextBlock Text="Use video files or animated images." FontSize="12" Foreground="{DynamicResource AMMuted}" Margin="0,4,0,15"/>
                    <WrapPanel Orientation="Horizontal">
                    <Controls:Tile Title="{x:Static p:Resources.txtTileGIF}" Click="Tile_GIF_Click" ClickMode="Release" Style="{StaticResource AMWallpaperTile}"
                              AutomationProperties.Name="GIF">
                            <Path Width="32" Height="32" Stretch="Uniform" Data="M4,5 L28,5 28,25 4,25 Z M4,10 L28,10 M10,19 L15,14 19,18 22,15 26,19"
                                  Stroke="{DynamicResource AMAccent}" StrokeThickness="2" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Fill="Transparent"/>
                        </Controls:Tile>
                    <Controls:Tile Title="{x:Static p:Resources.txtTileVideo}" Click="Tile_Video_Click" ClickMode="Release" Style="{StaticResource AMWallpaperTile}"
                              AutomationProperties.Name="Video">
                            <Path Width="32" Height="32" Stretch="Uniform" Data="M4,6 L25,6 25,26 4,26 Z M12,11 L20,16 12,21 Z M4,10 L25,10"
                                  Stroke="{DynamicResource AMAccent}" StrokeThickness="2" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Fill="Transparent"/>
                        </Controls:Tile>
                    </WrapPanel>
                  </StackPanel>
                </Border>
                    <Border Background="{DynamicResource AMSidebar}" BorderBrush="{DynamicResource AMBorder}"
                BorderThickness="1" CornerRadius="12" Padding="20" Margin="0,0,0,16">
                  <StackPanel>
                    <TextBlock Text="Interactive & games" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource AMText}"/>
                    <TextBlock Text="Add Unity, Godot, BizHawk or another supported application." FontSize="12" Foreground="{DynamicResource AMMuted}" Margin="0,4,0,15"/>
                    <WrapPanel Orientation="Horizontal">
                    <Controls:Tile Title="{x:Static p:Resources.txtTileUnity}" Click="Tile_Unity_Click" ClickMode="Release" Style="{StaticResource AMWallpaperTile}"
                              AutomationProperties.Name="Unity">
                            <Path Width="32" Height="32" Stretch="Uniform" Data="M4,10 L16,3 28,10 28,23 16,30 4,23 Z M4,10 L16,17 28,10 M16,17 L16,30"
                                  Stroke="{DynamicResource AMAccent}" StrokeThickness="2" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Fill="Transparent"/>
                        </Controls:Tile>
                    <Controls:Tile Title="{x:Static p:Resources.txtTileGodot}" Click="Tile_Godot_Click" ClickMode="Release" Style="{StaticResource AMWallpaperTile}"
                              AutomationProperties.Name="Godot">
                            <Path Width="32" Height="32" Stretch="Uniform" Data="M6,13 L6,25 26,25 26,13 22,9 18,11 16,6 13,11 9,9 Z M11,17 L11,19 M21,17 L21,19 M12,22 L20,22"
                                  Stroke="{DynamicResource AMAccent}" StrokeThickness="2" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Fill="Transparent"/>
                        </Controls:Tile>
                    <Controls:Tile Title="BizHawk" Click="Tile_BizHawk_Click" ClickMode="Release" Style="{StaticResource AMWallpaperTile}"
                              AutomationProperties.Name="BizHawk">
                            <Path Width="32" Height="32" Stretch="Uniform" Data="M8,13 L24,13 28,18 28,24 24,27 20,23 12,23 8,27 4,24 4,18 Z M12,16 L12,21 M10,18.5 L14,18.5 M22,18 L22,19"
                                  Stroke="{DynamicResource AMAccent}" StrokeThickness="2" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Fill="Transparent"/>
                        </Controls:Tile>
                    <Controls:Tile Title="{x:Static p:Resources.txtTileOther}" Click="Tile_Other_Click" ClickMode="Release" Style="{StaticResource AMWallpaperTile}"
                              AutomationProperties.Name="Other">
                            <Path Width="32" Height="32" Stretch="Uniform" Data="M5,5 L27,5 27,27 5,27 Z M5,11 L27,11 M9,8 L11,8 M15,8 L17,8"
                                  Stroke="{DynamicResource AMAccent}" StrokeThickness="2" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Fill="Transparent"/>
                        </Controls:Tile>
                    </WrapPanel>
                  </StackPanel>
                </Border>
                    <Border Background="{DynamicResource AMSidebar}" BorderBrush="{DynamicResource AMBorder}"
                BorderThickness="1" CornerRadius="12" Padding="20" Margin="0,0,0,16">
                  <StackPanel>
                    <TextBlock Text="Web" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource AMText}"/>
                    <TextBlock Text="Use HTML, a web page or an online video stream." FontSize="12" Foreground="{DynamicResource AMMuted}" Margin="0,4,0,15"/>
                    <WrapPanel Orientation="Horizontal">
                    <Controls:Tile Title="{x:Static p:Resources.txtTileHTML}" Click="Tile_HTML_Click" ClickMode="Release" Style="{StaticResource AMWallpaperTile}"
                              AutomationProperties.Name="HTML">
                            <Path Width="32" Height="32" Stretch="Uniform" Data="M13,9 L6,16 13,23 M19,9 L26,16 19,23 M17,7 L14,25"
                                  Stroke="{DynamicResource AMAccent}" StrokeThickness="2" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Fill="Transparent"/>
                        </Controls:Tile>
                    <Controls:Tile Title="{x:Static p:Resources.txtTileWebsite}" Click="Tile_URL_Click" ClickMode="Release" Style="{StaticResource AMWallpaperTile}"
                              AutomationProperties.Name="URL">
                            <Path Width="32" Height="32" Stretch="Uniform" Data="M8,5 L24,5 28,9 28,25 24,28 8,28 4,24 4,9 Z M4,12 L28,12 M9,8 L11,8 M14,8 L16,8 M10,19 L22,19"
                                  Stroke="{DynamicResource AMAccent}" StrokeThickness="2" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Fill="Transparent"/>
                        </Controls:Tile>
                    <Controls:Tile Title="Stream" Click="Tile_Video_stream_Click" ClickMode="Release" Style="{StaticResource AMWallpaperTile}"
                              AutomationProperties.Name="Video stream">
                            <Path Width="32" Height="32" Stretch="Uniform" Data="M4,7 L28,7 28,25 4,25 Z M12,13 L21,17 12,21 Z M8,29 L24,29"
                                  Stroke="{DynamicResource AMAccent}" StrokeThickness="2" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Fill="Transparent"/>
                        </Controls:Tile>
                    </WrapPanel>
                  </StackPanel>
                </Border>
                    <Border Background="{DynamicResource AMSidebar}" BorderBrush="{DynamicResource AMBorder}"
                BorderThickness="1" CornerRadius="12" Padding="20" Margin="0,0,0,16">
                  <StackPanel>
                    <TextBlock Text="Audio visualizers" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource AMText}"/>
                    <TextBlock Text="Create animated wallpaper from sound sources." FontSize="12" Foreground="{DynamicResource AMMuted}" Margin="0,4,0,15"/>
                    <WrapPanel Orientation="Horizontal">
                    <Controls:Tile Title="HTML Audio" Click="Tile_HTML_AUDIO_Click" ClickMode="Release" Style="{StaticResource AMWallpaperTile}"
                              AutomationProperties.Name="HTML AUDIO">
                            <Path Width="32" Height="32" Stretch="Uniform" Data="M5,13 L5,20 M10,7 L10,25 M15,12 L15,20 M20,4 L20,28 M25,11 L25,22"
                                  Stroke="{DynamicResource AMAccent}" StrokeThickness="2" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Fill="Transparent"/>
                        </Controls:Tile>
                    <Controls:Tile Title="Unity Audio" Click="Tile_UNITY_AUDIO_Click" ClickMode="Release" Style="{StaticResource AMWallpaperTile}"
                              AutomationProperties.Name="UNITY AUDIO">
                            <Path Width="32" Height="32" Stretch="Uniform" Data="M5,10 L16,4 27,10 27,22 16,28 5,22 Z M8,17 L12,17 M16,12 L16,22 M20,15 L20,19 M24,14 L24,20"
                                  Stroke="{DynamicResource AMAccent}" StrokeThickness="2" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Fill="Transparent"/>
                        </Controls:Tile>
                    </WrapPanel>
                  </StackPanel>
                </Border>
                    <Border Background="{DynamicResource AMSidebar}" BorderBrush="{DynamicResource AMBorder}"
                BorderThickness="1" CornerRadius="12" Padding="20" Margin="0,0,0,16">
                  <StackPanel>
                    <TextBlock Text="Wallpaper packages" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource AMText}"/>
                    <TextBlock Text="Import an existing Lively wallpaper archive." FontSize="12" Foreground="{DynamicResource AMMuted}" Margin="0,4,0,15"/>
                    <WrapPanel Orientation="Horizontal">
                    <Controls:Tile Title="Wallpaper .zip" Click="Tile_LIVELY_ZIP_Click" ClickMode="Release" Style="{StaticResource AMWallpaperTile}"
                              AutomationProperties.Name="LIVELY ZIP">
                            <Path Width="32" Height="32" Stretch="Uniform" Data="M8,4 L19,4 25,10 25,28 8,28 Z M19,4 L19,10 25,10 M13,10 L13,18 M13,21 L13,24 M16,21 L16,24"
                                  Stroke="{DynamicResource AMAccent}" StrokeThickness="2" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Fill="Transparent"/>
                        </Controls:Tile>
                    </WrapPanel>
                  </StackPanel>
                </Border>
                    <TextBlock Text="You can also drag files directly into the window."
                               Foreground="{DynamicResource AMMuted}" FontStyle="Italic" Margin="2,8,0,14"/>
                  </StackPanel>
                </ScrollViewer>
              </Grid>
            </TabItem>
            <TabItem Header="{x:Static p:Resources.titleSettings}" >
                <Grid Background="{DynamicResource AMBackground}" Margin="4,8,4,0">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" CanContentScroll="True" >
                        <Grid Margin="8,5,0,16">
                           <Grid.ColumnDefinitions>
                              <ColumnDefinition Width="*"/>
                              <ColumnDefinition Width="*"/>
                           </Grid.ColumnDefinitions>
                           <Grid.RowDefinitions><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                           <Border Grid.Column="0" Grid.Row="0" Margin="0,0,16,16"
                   Padding="20,18" Background="{DynamicResource AMSidebar}" BorderBrush="{DynamicResource AMBorder}"
                   BorderThickness="1" CornerRadius="12"><StackPanel Margin="0" VerticalAlignment="Top">

                                <Label Content="{x:Static p:Resources.txtLabel17}" Style="{StaticResource AMSettingsHeading}"/>

                                <Label Content="{x:Static p:Resources.txtVideoScaling}" FontSize="14.667" />
                                <ComboBox Name="comboBoxVideoPlayerScaling" Style="{StaticResource AMInputList}">
                                    <ComboBoxItem IsSelected="True"  Content="None"></ComboBoxItem>
                                    <ComboBoxItem Content="Fill" ></ComboBoxItem>
                                    <ComboBoxItem Content="Uniform"></ComboBoxItem>
                                    <ComboBoxItem  Content="Uniform Fill"></ComboBoxItem>
                                </ComboBox>
                                
                                <Label Content="{x:Static p:Resources.txtVideoPlayer}" ToolTip="{x:Static p:Resources.txtVideoPlayerToolTip}" FontSize="14.667" />
                                <ComboBox Name="comboBoxVideoPlayer" Style="{StaticResource AMInputList}">
                                    <!-- SelectionChanged="ComboBoxVideoPlayer_SelectionChanged"> -->
                                    <ComboBoxItem IsSelected="True" ToolTip="Use the included windows codec."  Content="{x:Static p:Resources.cmbBoxVideoPlayer1}"></ComboBoxItem>
                                    <ComboBoxItem ToolTip="Use external codec like LAV." Content="{x:Static p:Resources.cmbBoxVideoPlayer2}" ></ComboBoxItem>
                                    <ComboBoxItem >mpv</ComboBoxItem>
                                </ComboBox>
                                <TextBlock Canvas.Left="241" Canvas.Top="98">
                                <Hyperlink RequestNavigate="Hyperlink_RequestNavigate" NavigateUri="https://github.com/rocksdanister/lively/wiki/Video-Guide" 
                                           Foreground="{DynamicResource AccentColorBrush2}" ><TextBlock Text="{x:Static p:Resources.txtLabel11}" /></Hyperlink>
                                </TextBlock>
                                <Controls:ToggleSwitch Name="videoMuteToggle" Style="{StaticResource AMSettingsToggle}" Header="{x:Static p:Resources.txtAudioOut}" ToolTip="{x:Static p:Resources.txtAudioOutToolTip}" ></Controls:ToggleSwitch>
                                <TextBlock Name="vid_audio_WarningText" TextWrapping="Wrap" Foreground="{DynamicResource AccentColorBrush2}" Text="{x:Static p:Resources.txtAudioLabel1}"/>
                                
                                <Label Content="{x:Static p:Resources.txtLabel19}" Style="{StaticResource AMSettingsHeading}"/>
                                <Label Content="{x:Static p:Resources.txtBrowser}" ToolTip="{x:Static p:Resources.txtBrowserToolTip}" FontSize="14.667" />
                                <ComboBox>
                                    <ComboBoxItem IsSelected="True" >CEF (External)</ComboBoxItem>
                                    <ComboBoxItem IsEnabled="False" >Microsoft Edge (Internal)</ComboBoxItem>
                                </ComboBox>
                                <Controls:ToggleSwitch Name="cefAudioInMuteToggle" Style="{StaticResource AMSettingsToggle}" Header="{x:Static p:Resources.txtAudioIn}" ToolTip="{x:Static p:Resources.txtAudioInToolTip}"></Controls:ToggleSwitch>
                                <TextBlock Name="web_audio_WarningText" TextWrapping="Wrap" Foreground="IndianRed" Text="{x:Static p:Resources.txtAudioLabel2}"/>
                                
                            </StackPanel></Border>
                         </Grid>
                    </ScrollViewer>
                </Grid>
            </TabItem>
            <TabItem Header="Processes"><pm:ProcessManagerView/></TabItem>
            <TabItem Header="About">
                <Grid Background="{DynamicResource AMBackground}" Margin="12,15,12,10">
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <Border Grid.Row="0" Background="{DynamicResource AMSurface}" BorderBrush="{DynamicResource AMBorder}" BorderThickness="1" CornerRadius="16" Padding="22" Margin="0,0,0,14">
                        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <Border Width="76" Height="76" Background="{DynamicResource AMBackground}" CornerRadius="15" BorderBrush="{DynamicResource AMBorder}" BorderThickness="1" Padding="10">
                                <Image Source="{StaticResource AMBrandMark}" Stretch="Uniform"/>
                            </Border>
                            <StackPanel Grid.Column="1" Margin="18,1,5,0" VerticalAlignment="Center">
                                <Label Content="AM Lively Wallpaper" FontSize="26" FontWeight="SemiBold" Foreground="{DynamicResource AMText}" Padding="0"/>
                                <TextBlock Text="Dynamic desktop wallpaper • Performance control" Foreground="{DynamicResource AMMuted}" FontSize="12" Margin="0,6,0,0"/>
                                <TextBlock Text="Based on Lively Wallpaper v0.9.6.0 by rocksdanister · Microsoft Public License" Foreground="{DynamicResource AMMuted}" FontSize="11" Margin="0,9,0,0"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right">
                                <TextBlock Name="lblVersionNumber" Text="v0.9.6.1" Foreground="{DynamicResource AMAccent}" FontSize="17" HorizontalAlignment="Right" PreviewMouseDown="lblVersionNumber_PreviewMouseDown"/>
                                <Label Name="lblPortableTxt" Content="Portable" Foreground="{DynamicResource AMMuted}" Padding="0" HorizontalContentAlignment="Right" Margin="0,8,0,0"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                    <Border Grid.Row="1" Background="{DynamicResource AMSidebar}" BorderBrush="{DynamicResource AMBorder}" BorderThickness="1" CornerRadius="11" Padding="13" Margin="0,0,0,14">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Foreground="{DynamicResource AMMuted}" Text="OPEN SOURCE  ·  " FontWeight="Bold"/>
                            <TextBlock><Hyperlink RequestNavigate="Hyperlink_RequestNavigate" NavigateUri="https://github.com/rocksdanister/lively" Foreground="{DynamicResource AMAccent}">Original Lively Wallpaper</Hyperlink></TextBlock>
                            <TextBlock Text="   |   " Foreground="{DynamicResource AMMuted}"/>
                            <TextBlock><Hyperlink RequestNavigate="Hyperlink_RequestNavigate" NavigateUri="https://github.com/ashraftefa97-beep/AM-Lively-Wallpaper" Foreground="{DynamicResource AMAccent}">AM source repository</Hyperlink></TextBlock>
                        </StackPanel>
                    </Border>
                    <Border Grid.Row="2" Background="{DynamicResource AMSidebar}" BorderBrush="{DynamicResource AMBorder}" BorderThickness="1" CornerRadius="13" Padding="14">
                        <DockPanel LastChildFill="True">
                            <TextBlock DockPanel.Dock="Top" Text="Licenses &amp; acknowledgements" Foreground="{DynamicResource AMText}" FontSize="17" FontWeight="SemiBold" Margin="2,0,0,12"/>
                            <FlowDocumentScrollViewer Name="licenseFlowDocumentViewer" VerticalScrollBarVisibility="Visible" Foreground="#111111" BorderThickness="0">
                                <FlowDocument Name="licenseDocument" Hyperlink.RequestNavigate="Hyperlink_RequestNavigate_Warning" Background="#EDF0F5"/>
                            </FlowDocumentScrollViewer>
                        </DockPanel>
                    </Border>
                </Grid>
            </TabItem>
            <TabItem Header="Browser" Name="tabBrowser" Visibility="Hidden">
                <Border x:Name="borderBrowser">

                </Border>
            </TabItem>
           
        </Controls:MetroTabControl> 
        <Border Grid.Row="0" Grid.ColumnSpan="4" Background="{DynamicResource AMSidebar}" BorderBrush="{DynamicResource AMBorder}" BorderThickness="1" CornerRadius="14" Padding="14,9">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <Border Width="50" Height="50" CornerRadius="11" Background="{DynamicResource AMBackground}" BorderBrush="{DynamicResource AMBorder}" BorderThickness="1" Padding="6">
                    <Image Source="{StaticResource AMBrandMark}" Stretch="Uniform"/>
                </Border>
                <StackPanel Grid.Column="1" Margin="13,3,0,0" VerticalAlignment="Center">
                    <TextBlock Text="AM LIVELY" FontWeight="Bold" FontSize="19" Foreground="{DynamicResource AMText}"/>
                    <TextBlock Text="WALLPAPER  /  PERFORMANCE" FontWeight="SemiBold" FontSize="10" Foreground="{DynamicResource AMAccent}" Margin="0,3,0,0"/>
                </StackPanel>
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="+ Import wallpaper" Style="{StaticResource AMPrimaryButton}" Click="Button_Click_InstallWallpaper" Margin="0,0,15,0" ToolTip="Import a supported wallpaper file"/>
                    <Image x:Name="image" Width="24" Height="24" Margin="0,0,2,0" Cursor="Hand"
                           ToolTip="Display layout and monitor information" Source="/images/monitor-50xw.png"
                           MouseLeftButtonUp="Image_Display_MouseLeftButtonUp" VerticalAlignment="Center"/>
                </StackPanel>
            </Grid>
        </Border>
        <notification:NotificationMessageContainer Name="notify" Manager="{Binding Manager}" Grid.Row="1" Grid.ColumnSpan="4" Margin="-15,5,0,0" VerticalAlignment="Top"/>
    </Grid>
</Controls:MetroWindow>
