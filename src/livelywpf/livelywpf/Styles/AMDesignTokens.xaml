<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:sys="clr-namespace:System;assembly=mscorlib"
    xmlns:Controls="clr-namespace:MahApps.Metro.Controls;assembly=MahApps.Metro">
            <!-- BARQ-inspired identity; this is a scalable vector trace of the user-supplied flower mark. -->
            <SolidColorBrush x:Key="AMBackground" Color="#0F1115"/>
            <SolidColorBrush x:Key="AMSidebar" Color="#13161B"/>
            <SolidColorBrush x:Key="AMSurface" Color="#191D24"/>
            <SolidColorBrush x:Key="AMAccent" Color="#E5394B"/>
            <SolidColorBrush x:Key="AMText" Color="#F5F6F8"/>
            <SolidColorBrush x:Key="AMMuted" Color="#9EA7B6"/>
            <SolidColorBrush x:Key="AMBorder" Color="#303742"/>
            <DrawingImage x:Key="AMBrandMark">
                <DrawingImage.Drawing>
                    <GeometryDrawing Brush="#E5394B" Geometry="M 7,34 L 8,38 L 12,42 L 17,44 L 22,43 L 22,42 L 18,39 L 17,35 L 10,35 L 9,34 Z M 23,30 L 20,33 L 20,35 L 21,37 L 24,39 L 27,34 L 24,30 Z M 29,27 L 31,32 L 37,32 L 37,30 L 34,26 Z M 18,27 L 13,25 L 11,27 L 10,31 L 11,32 L 15,32 L 17,30 L 17,28 Z M 41,15 L 41,17 L 37,23 L 40,29 L 40,33 L 38,35 L 36,35 L 35,36 L 30,35 L 29,36 L 29,38 L 24,43 L 26,44 L 30,44 L 35,42 L 38,39 L 39,35 L 43,31 L 45,27 L 45,21 L 44,20 L 44,18 Z M 36,15 L 32,15 L 30,17 L 30,19 L 29,20 L 34,22 L 37,18 L 37,16 Z M 10,15 L 10,17 L 13,21 L 18,20 L 16,15 Z M 23,8 L 20,13 L 23,17 L 24,17 L 27,14 L 27,12 L 26,10 Z M 25,4 L 25,5 L 29,8 L 30,12 L 37,12 L 38,13 L 40,13 L 39,9 L 35,5 L 30,3 Z M 23,4 L 21,3 L 16,3 L 12,5 L 9,8 L 8,12 L 4,16 L 2,20 L 2,26 L 3,27 L 3,29 L 6,32 L 6,30 L 10,24 L 7,18 L 7,14 L 9,12 L 11,12 L 12,11 L 17,12 L 18,11 L 18,9 Z"/>
                </DrawingImage.Drawing>
            </DrawingImage>

            <SolidColorBrush x:Key="AMHover" Color="#242935"/>
            <SolidColorBrush x:Key="AMSelection" Color="#32242C"/>
            <Thickness x:Key="AMSpace1">4</Thickness>
            <Thickness x:Key="AMSpace2">8</Thickness>
            <Thickness x:Key="AMSpace3">12</Thickness>
            <Thickness x:Key="AMSpace4">16</Thickness>
            <Thickness x:Key="AMSpace6">24</Thickness>
            <CornerRadius x:Key="AMRadiusButton">9</CornerRadius>
            <CornerRadius x:Key="AMRadiusCard">12</CornerRadius>
            <sys:Double x:Key="AMFontCaption">11</sys:Double>
            <sys:Double x:Key="AMFontBody">13</sys:Double>
            <sys:Double x:Key="AMFontHeading">20</sys:Double>
            <!-- Existing MahApps control templates are preserved; only safe, keyed setters follow. -->
            <Style x:Key="AMInput" TargetType="{x:Type TextBox}">
                <Setter Property="Padding" Value="10,7"/>
                <Setter Property="MinHeight" Value="34"/>
                <Setter Property="Background" Value="{DynamicResource AMSurface}"/>
                <Setter Property="Foreground" Value="{DynamicResource AMText}"/>
                <Setter Property="BorderBrush" Value="{DynamicResource AMBorder}"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="FontFamily" Value="Segoe UI, Tahoma"/>
            </Style>
            <Style x:Key="AMInputList" TargetType="{x:Type ComboBox}">
                <Setter Property="MinHeight" Value="32"/>
                <Setter Property="Margin" Value="0,4,0,8"/>
                <Setter Property="Foreground" Value="{DynamicResource AMText}"/>
                <Setter Property="FontFamily" Value="Segoe UI, Tahoma"/>
            </Style>
            <Style x:Key="AMSettingsSlider" TargetType="{x:Type Slider}">
                <Setter Property="Margin" Value="0,7,0,12"/>
                <Setter Property="Foreground" Value="{DynamicResource AMAccent}"/>
            </Style>
            <Style x:Key="AMSettingsToggle" TargetType="{x:Type Controls:ToggleSwitch}">
                <Setter Property="Margin" Value="0,7,0,10"/>
                <Setter Property="FontFamily" Value="Segoe UI, Tahoma"/>
                <Setter Property="Foreground" Value="{DynamicResource AMText}"/>
            </Style>
            <Style x:Key="AMSettingsHeading" TargetType="{x:Type Label}">
                <Setter Property="Foreground" Value="{DynamicResource AMAccent}"/>
                <Setter Property="FontSize" Value="16"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="Padding" Value="0,4,0,8"/>
                <Setter Property="Margin" Value="0,0,0,10"/>
                <Setter Property="BorderThickness" Value="0,0,0,1"/>
                <Setter Property="BorderBrush" Value="{DynamicResource AMBorder}"/>
            </Style>
            <Style x:Key="AMLibraryItem" TargetType="{x:Type ListBoxItem}">
                <Setter Property="Margin" Value="0,0,5,6"/>
                <Setter Property="Padding" Value="3"/>
                <Setter Property="Foreground" Value="{DynamicResource AMText}"/>
                <Setter Property="Background" Value="Transparent"/>
                <Style.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter Property="Background" Value="{DynamicResource AMHover}"/>
                    </Trigger>
                    <Trigger Property="IsSelected" Value="True">
                        <Setter Property="Background" Value="{DynamicResource AMSelection}"/>
                        <Setter Property="BorderBrush" Value="{DynamicResource AMAccent}"/>
                    </Trigger>
                    <Trigger Property="IsKeyboardFocusWithin" Value="True">
                        <Setter Property="BorderBrush" Value="{DynamicResource AMAccent}"/>
                    </Trigger>
                </Style.Triggers>
            </Style>
            <Style x:Key="AMNavButton" TargetType="{x:Type Button}">
                <Setter Property="Background" Value="{DynamicResource AMSurface}"/>
                <Setter Property="Foreground" Value="{DynamicResource AMText}"/>
                <Setter Property="BorderBrush" Value="{DynamicResource AMBorder}"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="Padding" Value="14,8"/>
                <Setter Property="FontFamily" Value="Segoe UI"/>
                <Setter Property="FontSize" Value="13"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="{x:Type Button}">
                            <Border x:Name="chrome" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="9" SnapsToDevicePixels="True">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}" RecognizesAccessKey="True"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="chrome" Property="Background" Value="{DynamicResource AMHover}"/></Trigger>
                                <Trigger Property="IsPressed" Value="True"><Setter TargetName="chrome" Property="Opacity" Value="0.7"/></Trigger>
                                <Trigger Property="IsEnabled" Value="False"><Setter TargetName="chrome" Property="Opacity" Value="0.4"/></Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
            <Style x:Key="AMPrimaryButton" TargetType="{x:Type Button}" BasedOn="{StaticResource AMNavButton}">
                <Setter Property="Background" Value="{DynamicResource AMAccent}"/>
                <Setter Property="BorderBrush" Value="{DynamicResource AMAccent}"/>
                <Setter Property="Foreground" Value="White"/>
            </Style>

            <!-- Dashboard tile: only AM wallpaper type chooser uses this template. Tile Click handlers are kept. -->
            <Style x:Key="AMWallpaperTile" TargetType="{x:Type Controls:Tile}">
                <Setter Property="Width" Value="155"/>
                <Setter Property="Height" Value="118"/>
                <Setter Property="Margin" Value="0,0,12,12"/>
                <Setter Property="Padding" Value="12"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Foreground" Value="{DynamicResource AMText}"/>
                <Setter Property="Background" Value="{DynamicResource AMSurface}"/>
                <Setter Property="BorderBrush" Value="{DynamicResource AMBorder}"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="Template">
                  <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Controls:Tile}">
                      <Border x:Name="TileSurface" Background="{TemplateBinding Background}" CornerRadius="12"
                              BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                              SnapsToDevicePixels="True" Padding="14">
                        <Grid>
                          <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                          <ContentPresenter Grid.Row="0" HorizontalAlignment="Left" VerticalAlignment="Center"/>
                          <TextBlock Grid.Row="1" Text="{TemplateBinding Title}" Foreground="{DynamicResource AMText}"
                                     TextTrimming="CharacterEllipsis" FontSize="13" FontWeight="SemiBold"/>
                        </Grid>
                      </Border>
                      <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                          <Setter TargetName="TileSurface" Property="BorderBrush" Value="{DynamicResource AMAccent}"/>
                          <Setter TargetName="TileSurface" Property="Background" Value="{DynamicResource AMHover}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                          <Setter TargetName="TileSurface" Property="Opacity" Value="0.72"/>
                        </Trigger>
                        <Trigger Property="IsKeyboardFocusWithin" Value="True">
                          <Setter TargetName="TileSurface" Property="BorderBrush" Value="{DynamicResource AMAccent}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                          <Setter TargetName="TileSurface" Property="Opacity" Value="0.35"/>
                        </Trigger>
                      </ControlTemplate.Triggers>
                    </ControlTemplate>
                  </Setter.Value>
                </Setter>
            </Style>
</ResourceDictionary>
